# Git Ignore for Quadcopter Project

# Build & Compilation artifacts
**/build/
*.elf
*.bin
*.hex
*.eep
*.o
*.a
*.so
compile_commands.json
includes.cache
libraries.cache
build.options.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.venv
venv/
ENV/

# MATLAB / Simulink
*.asv
*.slxc
slprj/
*.autosave
*.m~

# OS & Editor Files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# External cloned reference repos & internal scratch notes
reference/
PROJECT_STATUS.md
quadcopter_matlab.zip
backup/*.bin
backup/*.hex

# Large temporary flight logs (keep final validated hardware log and sample log)
logs/*.csv
!logs/flight_log_sample.csv
!logs/final_flight_log.csv
gazebo/results/*.csv

# Raw photo dumps in root (organized copies are in docs/images/)
IMG_*.jpg
