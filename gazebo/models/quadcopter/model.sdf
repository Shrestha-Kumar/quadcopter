<?xml version="1.0"?>
<sdf version="1.9">
<model name="quadcopter">
  <pose>0 0 0.3 0 0 0</pose>
  <link name="base_link">
    <inertial><mass>0.90000</mass>
      <inertia><ixx>0.005938</ixx><iyy>0.005938</iyy><izz>0.010875</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <visual name="hub"><geometry><box><size>0.11 0.11 0.04</size></box></geometry>
      <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
    <visual name="arm_fr_rl"><pose>0 0 0 0 0 -0.785398</pose><geometry><box><size>0.450 0.025 0.015</size></box></geometry>
      <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
    <visual name="arm_fl_rr"><pose>0 0 0 0 0 0.785398</pose><geometry><box><size>0.450 0.025 0.015</size></box></geometry>
      <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
    <collision name="hub_col"><geometry><box><size>0.11 0.11 0.04</size></box></geometry></collision>
    <sensor name="imu" type="imu">
      <always_on>1</always_on><update_rate>200</update_rate><topic>quadcopter/imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.006981</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.006981</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.006981</stddev></noise></z>
        </angular_velocity>
      </imu>
    </sensor>
  </link>
  <link name="rotor_0">
    <pose>0.15910 -0.15910 0.03 0 0 0</pose>
    <inertial><mass>0.05</mass>
      <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <visual name="prop"><geometry><cylinder><radius>0.127</radius><length>0.004</length></cylinder></geometry>
      <material><ambient>0.1 0.4 0.9 0.5</ambient><diffuse>0.1 0.4 0.9 0.5</diffuse></material></visual>
  </link>
  <joint name="rotor_0_joint" type="revolute">
    <parent>base_link</parent><child>rotor_0</child>
    <axis><xyz>0 0 1</xyz><limit><lower>-1e12</lower><upper>1e12</upper><effort>1e6</effort></limit><dynamics><damping>0.0</damping></dynamics></axis>
  </joint>
  <link name="rotor_1">
    <pose>0.15910 0.15910 0.03 0 0 0</pose>
    <inertial><mass>0.05</mass>
      <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <visual name="prop"><geometry><cylinder><radius>0.127</radius><length>0.004</length></cylinder></geometry>
      <material><ambient>0.1 0.4 0.9 0.5</ambient><diffuse>0.1 0.4 0.9 0.5</diffuse></material></visual>
  </link>
  <joint name="rotor_1_joint" type="revolute">
    <parent>base_link</parent><child>rotor_1</child>
    <axis><xyz>0 0 1</xyz><limit><lower>-1e12</lower><upper>1e12</upper><effort>1e6</effort></limit><dynamics><damping>0.0</damping></dynamics></axis>
  </joint>
  <link name="rotor_2">
    <pose>-0.15910 0.15910 0.03 0 0 0</pose>
    <inertial><mass>0.05</mass>
      <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <visual name="prop"><geometry><cylinder><radius>0.127</radius><length>0.004</length></cylinder></geometry>
      <material><ambient>0.1 0.4 0.9 0.5</ambient><diffuse>0.1 0.4 0.9 0.5</diffuse></material></visual>
  </link>
  <joint name="rotor_2_joint" type="revolute">
    <parent>base_link</parent><child>rotor_2</child>
    <axis><xyz>0 0 1</xyz><limit><lower>-1e12</lower><upper>1e12</upper><effort>1e6</effort></limit><dynamics><damping>0.0</damping></dynamics></axis>
  </joint>
  <link name="rotor_3">
    <pose>-0.15910 -0.15910 0.03 0 0 0</pose>
    <inertial><mass>0.05</mass>
      <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
    <visual name="prop"><geometry><cylinder><radius>0.127</radius><length>0.004</length></cylinder></geometry>
      <material><ambient>0.1 0.4 0.9 0.5</ambient><diffuse>0.1 0.4 0.9 0.5</diffuse></material></visual>
  </link>
  <joint name="rotor_3_joint" type="revolute">
    <parent>base_link</parent><child>rotor_3</child>
    <axis><xyz>0 0 1</xyz><limit><lower>-1e12</lower><upper>1e12</upper><effort>1e6</effort></limit><dynamics><damping>0.0</damping></dynamics></axis>
  </joint>
  <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
    <jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.060</timeConstantUp><timeConstantDown>0.120</timeConstantDown>
    <maxRotVelocity>1000.0</maxRotVelocity>
    <motorConstant>8.000000e-06</motorConstant>
    <momentConstant>0.016</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <motorNumber>0</motorNumber>
    <rotorDragCoefficient>0</rotorDragCoefficient><rollingMomentCoefficient>0</rollingMomentCoefficient>
    <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
  </plugin>
  <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
    <jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName>
    <turningDirection>cw</turningDirection>
    <timeConstantUp>0.060</timeConstantUp><timeConstantDown>0.120</timeConstantDown>
    <maxRotVelocity>1000.0</maxRotVelocity>
    <motorConstant>8.000000e-06</motorConstant>
    <momentConstant>0.016</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <motorNumber>1</motorNumber>
    <rotorDragCoefficient>0</rotorDragCoefficient><rollingMomentCoefficient>0</rollingMomentCoefficient>
    <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
  </plugin>
  <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
    <jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName>
    <turningDirection>ccw</turningDirection>
    <timeConstantUp>0.060</timeConstantUp><timeConstantDown>0.120</timeConstantDown>
    <maxRotVelocity>1000.0</maxRotVelocity>
    <motorConstant>8.000000e-06</motorConstant>
    <momentConstant>0.016</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <motorNumber>2</motorNumber>
    <rotorDragCoefficient>0</rotorDragCoefficient><rollingMomentCoefficient>0</rollingMomentCoefficient>
    <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
  </plugin>
  <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
    <jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName>
    <turningDirection>cw</turningDirection>
    <timeConstantUp>0.060</timeConstantUp><timeConstantDown>0.120</timeConstantDown>
    <maxRotVelocity>1000.0</maxRotVelocity>
    <motorConstant>8.000000e-06</motorConstant>
    <momentConstant>0.016</momentConstant>
    <commandSubTopic>command/motor_speed</commandSubTopic>
    <motorNumber>3</motorNumber>
    <rotorDragCoefficient>0</rotorDragCoefficient><rollingMomentCoefficient>0</rollingMomentCoefficient>
    <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
    <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
    <motorType>velocity</motorType>
  </plugin>
  <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
    <dimensions>3</dimensions><odom_publish_frequency>200</odom_publish_frequency>
  </plugin>
</model>
</sdf>
